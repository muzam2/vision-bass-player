#usda 1.0
(
    defaultPrim = "Root"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "Root"
{
    # Unlit stereo material: the Camera Index Switch node picks the left or right texture per eye
    # on Apple Vision Pro. Both texture inputs are promoted to material parameters so the app can
    # bind DrawableQueue-backed TextureResources at runtime ("leftImage" / "rightImage").
    def Material "StereoScreen"
    {
        asset inputs:leftImage = @@
        asset inputs:rightImage = @@
        token outputs:mtlx:surface.connect = </Root/StereoScreen/UnlitSurface.outputs:out>
        token outputs:realitykit:vertex
        token outputs:surface

        def Shader "UnlitSurface"
        {
            uniform token info:id = "ND_realitykit_unlit_surfaceshader"
            bool inputs:applyPostProcessToneMap = 0
            color3f inputs:color.connect = </Root/StereoScreen/CameraSwitch.outputs:out>
            bool inputs:hasPremultipliedAlpha = 0
            float inputs:opacity = 1
            token outputs:out
        }

        def Shader "CameraSwitch"
        {
            uniform token info:id = "ND_realitykit_cameraindexswitch_color3"
            color3f inputs:left.connect = </Root/StereoScreen/LeftTexture.outputs:out>
            color3f inputs:mono.connect = </Root/StereoScreen/LeftTexture.outputs:out>
            color3f inputs:right.connect = </Root/StereoScreen/RightTexture.outputs:out>
            color3f outputs:out
        }

        def Shader "LeftTexture"
        {
            uniform token info:id = "ND_RealityKitTexture2D_color3"
            asset inputs:file.connect = </Root/StereoScreen.inputs:leftImage>
            float2 inputs:texcoord.connect = </Root/StereoScreen/TexCoord.outputs:out>
            color3f outputs:out
        }

        def Shader "RightTexture"
        {
            uniform token info:id = "ND_RealityKitTexture2D_color3"
            asset inputs:file.connect = </Root/StereoScreen.inputs:rightImage>
            float2 inputs:texcoord.connect = </Root/StereoScreen/TexCoord.outputs:out>
            color3f outputs:out
        }

        def Shader "TexCoord"
        {
            uniform token info:id = "ND_texcoord_vector2"
            float2 outputs:out
        }
    }
}
